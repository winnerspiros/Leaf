From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nostalfinals <yuu8583@proton.me>
Date: Thu, 16 Apr 2026 16:46:39 +0800
Subject: [PATCH] Skip item merge checks for full stacks


diff --git a/net/minecraft/world/entity/item/ItemEntity.java b/net/minecraft/world/entity/item/ItemEntity.java
--- a/net/minecraft/world/entity/item/ItemEntity.java
+++ b/net/minecraft/world/entity/item/ItemEntity.java
@@ -257,11 +257,17 @@ public class ItemEntity extends Entity implements TraceableEntity {
             // Gale start - hoist level and config lookups (#164)
             final net.minecraft.world.level.Level level = this.level();
             final double radius = level.spigotConfig.itemMerge; // Spigot
             final double yInflate = level.paperConfig().entities.behavior.onlyMergeItemsHorizontally ? 0 : radius - 0.5D;
             final boolean fixMergingThroughWalls = level.paperConfig().fixes.fixItemsMergingThroughWalls;
             // Gale end - hoist level and config lookups (#164)
             for (ItemEntity entity : level
                 .getEntitiesOfClass(ItemEntity.class, this.getBoundingBox().inflate(radius, yInflate, radius), other -> other != this && other.isMergable())) { // Spigot // Paper - configuration to only merge items horizontally
+                // Leaf start - Skip item merge checks for full stacks
+                final ItemStack item = this.getItem();
+                if (this.isRemoved() || item.getCount() >= item.getMaxStackSize()) {
+                    break;
+                }
+                // Leaf end - Skip item merge checks for full stacks
                 if (entity.isMergable()) {
                     // Paper start - Fix items merging through walls
                     if (fixMergingThroughWalls) {
@@ -266,10 +272,7 @@ public class ItemEntity extends Entity implements TraceableEntity {
                         }
                     }
                     // Paper end - Fix items merging through walls
-                    this.tryToMerge(entity);
-                    if (this.isRemoved()) {
-                        break;
-                    }
+                    this.tryToMerge(entity, item, entity.getItem());
                 }
             }
         }
@@ -283,7 +286,12 @@ public class ItemEntity extends Entity implements TraceableEntity {
     private void tryToMerge(final ItemEntity other) {
         ItemStack thisItemStack = this.getItem();
         ItemStack otherItemStack = other.getItem();
+        // Leaf start - Skip item merge checks for full stacks
+        tryToMerge(other, thisItemStack, otherItemStack);
+    }
+    private void tryToMerge(final ItemEntity other, final ItemStack thisItemStack, final ItemStack otherItemStack) {
+        // Leaf end - Skip item merge checks for full stacks
         if (Objects.equals(this.target, other.target) && areMergable(thisItemStack, otherItemStack)) {
             if (org.dreeam.leaf.config.modules.gameplay.UseSpigotItemMergingMech.enabled || otherItemStack.getCount() < thisItemStack.getCount()) { // Leaf - KeYi - Configurable spigot item merging mechanism
                 merge(this, thisItemStack, other, otherItemStack);
