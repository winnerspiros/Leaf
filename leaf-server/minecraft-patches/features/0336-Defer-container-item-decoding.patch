diff --git a/net/minecraft/world/level/storage/TagValueInput.java b/net/minecraft/world/level/storage/TagValueInput.java
--- a/net/minecraft/world/level/storage/TagValueInput.java
+++ b/net/minecraft/world/level/storage/TagValueInput.java
@@ -37,6 +37,27 @@ public class TagValueInput implements ValueInput {
         this.input = input;
     }
 
+    // Leaf start - Defer container item decoding
+    public TagValueInput withProblemReporter(final ProblemReporter problemReporter) {
+        return new TagValueInput(problemReporter, this.context, this.input);
+    }
+
+    public TagValueInput retainField(final String name) {
+        CompoundTag retained = new CompoundTag();
+        retained.put(name, this.input.get(name));
+        return new TagValueInput(ProblemReporter.DISCARDING, this.context, retained);
+    }
+
+    public void copyFieldTo(final String name, final ValueOutput output) {
+        Tag value = this.input.get(name).copy();
+        if (output instanceof TagValueOutput tagOutput) {
+            tagOutput.buildResult().put(name, value);
+        } else {
+            output.store(name, Codec.PASSTHROUGH, new com.mojang.serialization.Dynamic<>(NbtOps.INSTANCE, value));
+        }
+    }
+    // Leaf end - Defer container item decoding
+
