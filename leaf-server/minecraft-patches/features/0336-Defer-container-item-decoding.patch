diff --git a/net/minecraft/world/ContainerHelper.java b/net/minecraft/world/ContainerHelper.java
--- a/net/minecraft/world/ContainerHelper.java
+++ b/net/minecraft/world/ContainerHelper.java
@@ -45,6 +45,37 @@ public class ContainerHelper {
         }
     }
 
+    // Leaf start - Defer container item decoding
+    public static @org.jspecify.annotations.Nullable PendingItems loadAllItemsDeferred(final ValueInput input, final NonNullList<ItemStack> itemStacks) {
+        if (org.dreeam.leaf.config.modules.opt.ContainerItemLazyLoading.lazyContainerItemLoading
+            && input instanceof net.minecraft.world.level.storage.TagValueInput tagInput
+            && !input.listOrEmpty(TAG_ITEMS, ItemStackWithSlot.CODEC).isEmpty()) {
+            return new PendingItems(tagInput);
+        }
+        loadAllItems(input, itemStacks);
+        return null;
+    }
+
+    public static final class PendingItems {
+        private static final org.slf4j.Logger LOGGER = com.mojang.logging.LogUtils.getLogger();
+        private final net.minecraft.world.level.storage.TagValueInput input;
+
+        private PendingItems(final net.minecraft.world.level.storage.TagValueInput input) {
+            this.input = input.retainField(TAG_ITEMS);
+        }
+
+        public void load(final NonNullList<ItemStack> itemStacks, final net.minecraft.util.ProblemReporter.PathElement path) {
+            try (net.minecraft.util.ProblemReporter.ScopedCollector reporter = new net.minecraft.util.ProblemReporter.ScopedCollector(path, LOGGER)) {
+                loadAllItems(this.input.withProblemReporter(reporter), itemStacks);
+            }
+        }
+
+        public void save(final ValueOutput output) {
+            this.input.copyFieldTo(TAG_ITEMS, output);
+        }
+    }
+    // Leaf end - Defer container item decoding
+
     public static int clearOrCountMatchingItems(
         final Container container, final Predicate<ItemStack> predicate, final int amountToRemove, final boolean countingOnly
     ) {
