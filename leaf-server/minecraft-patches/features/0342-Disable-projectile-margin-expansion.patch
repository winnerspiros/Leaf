From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leaf <leaf@users.noreply.github.com>
Date: Sat, 18 Oct 2026 00:00:00 +0000
Subject: [PATCH] Disable projectile margin expansion (Leaf #923)

Port of Winds-Studio/Leaf #923 against our tree.

diff --git a/net/minecraft/world/entity/projectile/ProjectileUtil.java b/net/minecraft/world/entity/projectile/ProjectileUtil.java
--- a/net/minecraft/world/entity/projectile/ProjectileUtil.java
+++ b/net/minecraft/world/entity/projectile/ProjectileUtil.java
@@ -151,3 +151,4 @@ public final class ProjectileUtil {
     }
 
     public static float computeMargin(final Entity source) {
+        if (org.dreeam.leaf.config.modules.gameplay.ProjectileMarginExpansion.disableProjectileMarginExpansion) return 0.3F; // Leaf - Disable projectile margin expansion
         return Math.max(0.0F, Math.min(0.3F, (source.tickCount - 2) / 20.0F));
     }
