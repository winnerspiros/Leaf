Subject: [PATCH] Async block reads for LevelChunkSection (Leaf #733)

Port of Winds-Studio/Leaf #733 against our tree (adapted:
our PalettedContainer already has leaf$getDataAcquire fast-path,
no LithiumHashPalette in tree).
Adds getBlockStateAsync + getBlockModificationCount, ARM palette
race fences.

diff --git a/net/minecraft/world/level/chunk/LevelChunkSection.java b/net/minecraft/world/level/chunk/LevelChunkSection.java
--- a/net/minecraft/world/level/chunk/LevelChunkSection.java
+++ b/net/minecraft/world/level/chunk/LevelChunkSection.java
@@ -29,5 +29,17 @@ public class LevelChunkSection implements ca.spottedleaf.moonrise.patches.block_
     private short specialCollidingBlocks;
     private final ca.spottedleaf.moonrise.common.list.ShortList tickingBlocks = new ca.spottedleaf.moonrise.common.list.ShortList();
+    // Leaf start - Async block reads for LevelChunkSection
+    private int blockModificationCount;
+    private static final java.lang.invoke.VarHandle BLOCK_MODIFICATION_COUNT_HANDLE;
+    static {
+        try {
+            BLOCK_MODIFICATION_COUNT_HANDLE = java.lang.invoke.MethodHandles.lookup()
+                .findVarHandle(LevelChunkSection.class, "blockModificationCount", int.class);
+        } catch (ReflectiveOperationException e) {
+            throw new ExceptionInInitializerError(e);
+        }
+    }
+    // Leaf end - Async block reads for LevelChunkSection
 
     @Override
     public final boolean moonrise$hasSpecialCollidingBlocks() {
@@ -71,6 +83,21 @@ public class LevelChunkSection implements ca.spottedleaf.moonrise.patches.block_
         return this.states.get(sectionX, sectionY, sectionZ);
     }
 
+    // Leaf start - Async block reads for LevelChunkSection
+    /** Off-thread block read, see {@link PalettedContainer#getAsync}. */
+    public BlockState getBlockStateAsync(final int sectionX, final int sectionY, final int sectionZ) {
+        return this.states.getAsync(sectionX, sectionY, sectionZ);
+    }
+
+    /**
+     * Incremented after every {@link #setBlockState} on this section, checked or not. A thread that reads
+     * an unchanged count has seen every block write made before the count was last incremented.
+     */
+    public int getBlockModificationCount() {
+        return (int) BLOCK_MODIFICATION_COUNT_HANDLE.getAcquire(this);
+    }
+    // Leaf end - Async block reads for LevelChunkSection
+
     public FluidState getFluidState(final int sectionX, final int sectionY, final int sectionZ) {
         return this.states.get(sectionX, sectionY, sectionZ).getFluidState(); // Paper - Perf: Optimise LevelChunk#getFluidState; diff on change - we expect this to be effectively just get(x, y, z).getFluidState(). If this changes we need to check other patches that use BlockBehaviour#getFluidState.
     }
@@ -133,6 +160,7 @@ public class LevelChunkSection implements ca.spottedleaf.moonrise.patches.block_
         } else {
             previous = this.states.getAndSetUnchecked(sectionX, sectionY, sectionZ, state);
         }
+        BLOCK_MODIFICATION_COUNT_HANDLE.setRelease(this, this.blockModificationCount + 1); // Leaf - Async block reads for LevelChunkSection
 
         if (!previous.isAir()) {
             this.nonEmptyBlockCount--;
