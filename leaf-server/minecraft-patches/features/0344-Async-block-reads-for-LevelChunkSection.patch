diff --git a/net/minecraft/world/level/chunk/PalettedContainer.java b/net/minecraft/world/level/chunk/PalettedContainer.java
--- a/net/minecraft/world/level/chunk/PalettedContainer.java
+++ b/net/minecraft/world/level/chunk/PalettedContainer.java
@@ -206,8 +206,8 @@ public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainer
         // Paper end - Anti-Xray
         PalettedContainer.Data<T> newData = this.createOrReuseData(oldData, bits);
         newData.copyFrom(oldData.palette, oldData.storage);
+        this.updateData(newData); // Paper - optimise palette reads // Leaf - Async block reads for LevelChunkSection - set the flat palette before publishing
         this.data = newData;
-        this.updateData(this.data); // Paper - optimise palette reads
         // Paper start - Anti-Xray
         this.addPresetValues();
         return lastAddedValue == null ? -1 : newData.palette.idFor(lastAddedValue, PaletteResize.noResizeExpected());
@@ -268,9 +268,35 @@ public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainer
     }
     // Leaf end - optimize PalettedContainer#get
 
+    // Leaf start - Async block reads for LevelChunkSection
+    /**
+     * Reads a value from any thread without locking or copying. Every call returns a value that was
+     * stored at that position at some point: storage and palette come from the same {@link Data},
+     * and a palette entry referenced by storage is never missed. Separate calls are not atomic with
+     * each other.
+     */
+    public T getAsync(final int x, final int y, final int z) {
+        final PalettedContainer.Data<T> data = (PalettedContainer.Data<T>) DATA_HANDLE.getAcquire(this);
+        final int index = this.strategy.getIndex(x, y, z);
+        final T[] palette = data.moonrise$getPalette();
+        if (palette != null) {
+            final int paletteIdx = data.storage.get(index);
+            if (paletteIdx < palette.length) {
+                final T value = palette[paletteIdx];
+                if (value != null) {
+                    return value;
+                }
+            }
+        }
+        final int paletteIdx = data.storage.get(index);
+        java.lang.invoke.VarHandle.acquireFence();
+        return this.readPalette(data, paletteIdx);
+    }
+    // Leaf end - Async block reads for LevelChunkSection
+
     public T get(final int index) { // Paper - public
         // Paper start - optimise palette reads
         final PalettedContainer.Data<T> data = (PalettedContainer.Data<T>) DATA_HANDLE.getAcquire(this); // Leaf - optimize PalettedContainer#get
         return this.readPalette(data, data.storage.get(index));
         // Paper end - optimise palette reads

