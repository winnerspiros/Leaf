From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leaf Max-Perf <leaf@localhost>
Date: Sat, 10 Oct 2026 00:00:00 +0000
Subject: [PATCH] Leaf max-perf: reduce light-engine + IO buffer retention

- LightEngine MIN_QUEUE_SIZE 512 -> 128, CACHE_SIZE 2 -> 1
- DataLayerStorageMap CACHE_SIZE 2 -> 1
- Luminol scratch retain 2MiB -> 1MiB

diff --git a/net/minecraft/world/level/lighting/LightEngine.java b/net/minecraft/world/level/lighting/LightEngine.java
--- a/net/minecraft/world/level/lighting/LightEngine.java
+++ b/net/minecraft/world/level/lighting/LightEngine.java
@@ -24,6 +24,8 @@ public abstract class LightEngine<M extends DataLayerStorageMap<M>, S extends Da
     protected static final int MIN_OPACITY = 1;
     protected static final long PULL_LIGHT_IN_ENTRY = LightEngine.QueueEntry.decreaseAllDirections(1);
-    private static final int MIN_QUEUE_SIZE = 512;
+    // Leaf start - max-perf: smaller light queue for low-RAM box
+    private static final int MIN_QUEUE_SIZE = 128;
+    // Leaf end - max-perf
     protected static final Direction[] PROPAGATION_DIRECTIONS = Direction.values();
     protected final LightChunkGetter chunkSource;
     protected final S storage;
@@ -31,6 +33,8 @@ public abstract class LightEngine<M extends DataLayerStorageMap<M>, S extends Da
     private final LongOpenHashSet blockNodesToCheck = new LongOpenHashSet(512, 0.5F);
     private final LongArrayFIFOQueue decreaseQueue = new LongArrayFIFOQueue();
     private final LongArrayFIFOQueue increaseQueue = new LongArrayFIFOQueue();
-    private static final int CACHE_SIZE = 2;
+    // Leaf start - max-perf: single light-chunk slot
+    private static final int CACHE_SIZE = 1;
+    // Leaf end - max-perf
     private final long[] lastChunkPos = new long[2];
     private final LightChunk[] lastChunk = new LightChunk[2];
diff --git a/net/minecraft/world/level/lighting/DataLayerStorageMap.java b/net/minecraft/world/level/lighting/DataLayerStorageMap.java
--- a/net/minecraft/world/level/lighting/DataLayerStorageMap.java
+++ b/net/minecraft/world/level/lighting/DataLayerStorageMap.java
@@ -6,4 +6,6 @@
 public abstract class DataLayerStorageMap<M extends DataLayerStorageMap<M>> {
-    private static final int CACHE_SIZE = 2;
+    // Leaf start - max-perf: single data-layer slot
+    private static final int CACHE_SIZE = 1;
+    // Leaf end - max-perf
     private final long[] lastSectionKeys = new long[2];
     private final @Nullable DataLayer[] lastSections = new DataLayer[2];
