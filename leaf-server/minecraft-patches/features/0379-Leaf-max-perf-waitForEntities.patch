From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leaf Max-Perf <leaf@localhost>
Date: Sat, 11 Oct 2026 00:00:00 +0000
Subject: [PATCH] Leaf max-perf: zero-alloc waitForEntities chunk loop

Avoids ChunkPos.rangeClosed(...).toList() allocation on teleport/summon paths.
Idea credit: pipatpad2011/Leaf chunk-optimization docs.

diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -3266,16 +3266,23 @@ public class ServerLevel extends Level implements ChunkHolder.PlayerProvider, Se
     }

     public void waitForEntities(final ChunkPos centerChunk, final int radius) {
-        List<ChunkPos> chunks = ChunkPos.rangeClosed(centerChunk, radius).toList();
+        // Leaf start - max-perf: avoid rangeClosed list alloc; iterate packed coords directly
+        final int cx = centerChunk.getMiddleBlockX() >> 4;
+        final int cz = centerChunk.getMiddleBlockZ() >> 4;
+        // Leaf end - max-perf
         this.chunkSource.mainThreadProcessor.managedBlock(() -> { // Paper - rewrite chunk system
             //this.entityManager.processPendingLoads(); // Paper - rewrite chunk system

-            for (ChunkPos chunk : chunks) {
-                if (!this.areEntitiesLoaded(chunk.pack())) {
-                    return false;
+            // Leaf start - max-perf: direct packed-long loop, no ChunkPos objects
+            for (int x = cx - radius; x <= cx + radius; x++) {
+                for (int z = cz - radius; z <= cz + radius; z++) {
+                    if (!this.areEntitiesLoaded(ChunkPos.pack(x, z))) {
+                        return false;
+                    }
                 }
             }
+            // Leaf end - max-perf

             return true;
         });
     }
