From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Leaf Performance experiments <noreply@localhost>
Date: Thu, 12 Sep 2026 02:30:00 +0800
Subject: [PATCH] Avoid map tracking predicate allocations

diff --git a/net/minecraft/world/entity/player/Inventory.java b/net/minecraft/world/entity/player/Inventory.java
--- a/net/minecraft/world/entity/player/Inventory.java
+++ b/net/minecraft/world/entity/player/Inventory.java
@@ -492,11 +492,29 @@ public class Inventory implements Container, Nameable {
         return false;
     }

+    // Leaf-Performance start - avoid allocating map match predicates in MapItemSavedData
+    public boolean containsMap(final net.minecraft.world.item.Item mapItem, final net.minecraft.world.level.saveddata.maps.MapId mapId) {
+        for (int i = 0, size = this.items.size(); i < size; i++) {
+            final ItemStack stack = this.items.get(i);
+            if (stack.is(mapItem) && java.util.Objects.equals(mapId, stack.get(DataComponents.MAP_ID))) {
+                return true;
+            }
+        }
+        for (final EquipmentSlot slot : EQUIPMENT_SLOTS_SORTED_BY_INDEX) {
+            final ItemStack stack = this.equipment.get(slot);
+            if (stack.is(mapItem) && java.util.Objects.equals(mapId, stack.get(DataComponents.MAP_ID))) {
+                return true;
+            }
+        }
+        return false;
+    }
+    // Leaf-Performance end - avoid allocating map match predicates in MapItemSavedData
+
     public boolean contains(final Predicate<ItemStack> predicate) {
         // Leaf start - Remove iterators from Inventory
         for (int i = 0, size = this.items.size(); i < size; i++) {
             ItemStack stack = this.items.get(i);
             if (predicate.test(stack)) {
                 return true;
             }
         }
