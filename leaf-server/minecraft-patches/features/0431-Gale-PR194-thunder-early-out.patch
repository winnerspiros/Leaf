diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -1291,6 +1291,11 @@ public class ServerLevel extends Level implements ChunkHolder.PlayerProvider, Se
     }

     public void tickThunder(final LevelChunk chunk) {
+        // Gale start - Leaf: skip profiler + random call when thunder cannot happen
+        if (!this.isThundering() || !this.isRaining()) {
+            return;
+        }
+        // Gale end - Leaf: skip profiler + random call when thunder cannot happen
         ChunkPos chunkPos = chunk.getPos();
         boolean raining = this.isRaining();
         int minX = chunkPos.getMinBlockX();
