From: Pufferfish <pufferfish@localhost>
Date: Sun, 11 Oct 2026 00:00:00 +0000
Subject: [PATCH] Cache climbing check for activation

diff --git a/src/main/java/io/papermc/paper/entity/activation/ActivationRange.java b/io/papermc/paper/entity/activation/ActivationRange.java
--- a/src/main/java/io/papermc/paper/entity/activation/ActivationRange.java
+++ b/src/main/java/io/papermc/paper/entity/activation/ActivationRange.java
@@ -240,7 +240,7 @@ public final class ActivationRange {
         }
         // special cases.
         if (entity instanceof final LivingEntity living) {
-            if (living.onClimbable() || living.jumping || living.hurtTime > 0 || !living.activeEffects.isEmpty() || living.isFreezing()) {
+            if (living.onClimbableCached() || living.jumping || living.hurtTime > 0 || !living.activeEffects.isEmpty() || living.isFreezing()) { // Pufferfish - Use Cached
                 return 1;
             }
             if (entity instanceof final Mob mob && mob.getTarget() != null) {
